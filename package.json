{
  "name": "effix",
  "version": "0.1.0",
  "description": "Class-driven JavaScript effects (particles, parallax, reveal, tilt, carousels, popups\u2026) plus interactive SVG charts and funnels, built to pair with Shine CSS. Only features found on the page start.",
  "main": "dist/effix.min.js",
  "module": "dist/effix.esm.js",
  "style": "dist/effix.min.css",
  "unpkg": "dist/effix.min.js",
  "jsdelivr": "dist/effix.min.js",
  "exports": {
    ".": {
      "import": "./dist/effix.esm.js",
      "default": "./dist/effix.min.js"
    },
    "./all": {
      "import": "./dist/effix.all.esm.js",
      "default": "./dist/effix.all.min.js"
    },
    "./charts": "./dist/effix-charts.min.js",
    "./css": "./dist/effix.min.css",
    "./charts.css": "./dist/effix-charts.min.css",
    "./all.css": "./dist/effix.all.min.css",
    "./core": "./src/core.js",
    "./features/*": "./src/features/*.js",
    "./charts/*": "./src/charts/*.js",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./auto": "./dist/effix.auto.min.js",
    "./core.min": "./dist/effix.core.min.js",
    "./react": "./src/integrations/react.js",
    "./vue": "./src/integrations/vue.js",
    "./svelte": "./src/integrations/svelte.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.meta.js"
  ],
  "sideEffects": [
    "*.css",
    "./dist/*.js"
  ],
  "scripts": {
    "build": "node build.js && node docs.js",
    "docs": "node docs.js",
    "test": "node tests/smoke.js chromium firefox webkit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asticore/effix.git"
  },
  "keywords": [
    "effects",
    "animation",
    "particles",
    "parallax",
    "scroll-reveal",
    "shine-css",
    "vanilla-js",
    "charts",
    "funnel",
    "svg",
    "react",
    "vue",
    "svelte"
  ],
  "author": "Matt Peterman",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.56.0"
  },
  "homepage": "https://asticore.github.io/effix/docs/"
}
